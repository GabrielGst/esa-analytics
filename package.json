{
  "private": true,
  "scripts": {
    "python-init": "python3 -m venv flask/.venv && . flask/.venv/bin/activate && pip3 install -r flask/requirements.txt",
    "build": "rm -rf .next && next build",
    "init": "node scripts/init-log.js && npm run python-init && npm install && npm run build",
    "dev": "concurrently \"next dev -H 127.0.0.1 -p 3001\" \"PORT=5051 FLASK_HOST=127.0.0.1 flask/.venv/bin/python3 flask/index.py dev\""
  },
