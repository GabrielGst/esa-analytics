FROM node:20-slim

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# next-auth reads AUTH_SECRET at module init time; provide a placeholder
# so `next build` succeeds. The real secret is injected at runtime via env_file.
ARG AUTH_SECRET=build-time-placeholder
ENV AUTH_SECRET=$AUTH_SECRET

RUN npm run build

EXPOSE 5000

CMD ["node_modules/.bin/next", "start", "-H", "0.0.0.0", "-p", "5000"]
